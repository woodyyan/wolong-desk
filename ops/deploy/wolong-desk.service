# 卧龙 BTC 交易台 · systemd 单元（模板）
#
# 安装（在服务器上执行，替换两处占位符）：
#   sudo sed -e "s|__DESK_DIR__|/opt/wolong-desk|g" -e "s|__USER__|ubuntu|g" \
#     ops/deploy/wolong-desk.service | sudo tee /etc/systemd/system/wolong-desk.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now wolong-desk
#
# 常用：
#   systemctl status wolong-desk      # 看状态
#   journalctl -u wolong-desk -f     # 跟日志
#   systemctl restart wolong-desk    # 重启
#   systemctl stop wolong-desk       # 停止
#   systemctl disable wolong-desk    # 取消开机自启
#
# 注意：DESK_HOST 默认保持 127.0.0.1（只让本机 nginx 反代访问，最安全）。
# 若坚持直接对外暴露 8790，把下面的 Environment 改成 0.0.0.0 —— 但服务无鉴权，
# /api/reset、/api/start 任何人可 POST，强烈建议走 nginx + Basic Auth。

[Unit]
Description=Wolong BTC Desk (paper trading panel)
Documentation=file:__DESK_DIR__/HANDOVER.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DESK_DIR__

# Python 输出不缓冲，否则 print 的日志要攒满 4KB 才落盘，你会以为服务没起来
Environment=PYTHONUNBUFFERED=1
# 监听地址：127.0.0.1 = 仅本机/反代可达；0.0.0.0 = 直接对外（不建议裸奔）
Environment=DESK_HOST=127.0.0.1
# systemd 的 PATH 很干净，若 python3 不在 /usr/bin，用绝对路径覆盖
Environment=PYTHON=python3
# 若服务器需走代理拉行情（境外源不可达时）
# Environment=HTTPS_PROXY=http://127.0.0.1:7890

ExecStart=__DESK_DIR__/start.sh

# 崩溃/异常退出自动拉起（手动 stop 不触发）
Restart=on-failure
RestartSec=10
# start.sh 是 exec 前台运行，不用 Type=forking；停止时给 SIGINT 让它走优雅退出分支
KillSignal=SIGINT
TimeoutStopSec=20

# 日志进 journald：journalctl -u wolong-desk -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wolong-desk

# 轻度加固（不影响 8790 监听与 state/data 读写）
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
